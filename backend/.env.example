# Backend Environment Variables Template
# Copy this to .env and fill in the actual values

PORT=5001
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=AppName
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# For Production on Render:
# 1. PORT=5001 (automatically set)
# 2. NODE_ENV=production (set in Render dashboard)
# 3. MONGO_URI=mongodb+srv://... (set in Render dashboard from MongoDB Atlas)
# 4. JWT_SECRET=... (set in Render dashboard - keep it secret!)
# 5. FRONTEND_URL=https://your-vercel-frontend.vercel.app (set in Render dashboard)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cakesman
# JWT_SECRET=your-secure-secret-key-here
# NODE_ENV=production
